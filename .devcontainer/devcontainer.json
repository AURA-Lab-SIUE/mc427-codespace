{
  "name": "MC 427: R, tidyverse and effectsize",
  "build": { "dockerfile": "Dockerfile" },
  "customizations": {
    "vscode": {
      "extensions": [
        "REditorSupport.r@3.0.1",
        "mechatroner.rainbow-csv@3.24.1",
        "janisdd.vscode-edit-csv@0.11.9",
        "aura-lab-siue.r-companion@0.1.3"
      ],
      "settings": {
        "r.rterm.linux": "/usr/local/bin/R",
        "r.bracketedPaste": false,
        "r.lsp.promptToInstall": false,
        "r.lsp.diagnostics": false,
        "scm.countBadge": "off",
        "files.autoSave": "afterDelay",
        "editor.wordWrap": "on"
      }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
